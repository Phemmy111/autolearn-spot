# Payment Mode
NEXT_PUBLIC_PAYMENT_MODE=live

# Live Payment Link
NEXT_PUBLIC_PAYSTACK_PAYMENT_URL=https://paystack.shop/pay/yoksvlq4xn

# Test Payment Link
NEXT_PUBLIC_PAYSTACK_TEST_LINK=https://paystack.shop/pay/vmlnn84vds

# Paystack Secret Key
PAYSTACK_SECRET_KEY=

# ALEX Provider Encryption Key (32 bytes for AES-256-GCM)
# IMPORTANT: Change this in production to a secure random 32-byte key
ALEX_PROVIDER_ENCRYPTION_KEY=

# Tavily Search API Key for Phase 3C Web Research
# Get your API key from https://tavily.com/
TAVILY_API_KEY=

# Fallback Vision API for Image Analysis
# Used when the primary AI provider doesn't support vision
# Options: openai, gemini
# For OpenAI: set OPENAI_API_KEY
# For Gemini: set GEMINI_API_KEY
ALEX_VISION_PROVIDER=openai

# OpenAI API Key (for vision fallback)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini API Key (for vision fallback)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
